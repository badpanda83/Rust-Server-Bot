# Discord
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_GUILD_ID=your_guild_id_here

# RCON Connection
RCON_HOST=your.rust.server.ip
RCON_PORT=28016
RCON_PASSWORD=your_rcon_password

# Discord Channel IDs
CHANNEL_REPORTS=
CHANNEL_KEYWORDS=
CHANNEL_CHAT=
CHANNEL_STATUS=
CHANNEL_JOINLEAVE=

# Moderation - comma-separated list of keywords to flag
KEYWORD_LIST=cheat,hack,exploit,aimbot,esp

# Discord role ID that can use /rcon command
RCON_ROLE_ID=your_admin_role_id

# How often to update server status embed (in seconds)
STATUS_INTERVAL=60
